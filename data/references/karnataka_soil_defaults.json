    "description": "Default soil properties for Karnataka soil types. Used to pre-fill the UI when a farmer selects a soil type.",
    "note": "Values are approximate typical ranges compiled from ICAR-NBSS&LUP guidelines, UAS Dharwad/Bengaluru research, and Krishi Vigyan Kendra publications. Exact values vary by location, depth, season, and management history.",
    "units": {
      "ph": "pH scale (0-14)",
      "nitrogen": "kg/ha (available N)",
      "phosphorus": "kg/ha (available P2O5)",
      "potassium": "kg/ha (available K2O)"
    },
    "sources": [
      "ICAR-NBSS&LUP Soil Resource Maps of India",
      "UAS Dharwad — Department of Soil Science and Agricultural Chemistry",
      "UAS Bengaluru — Soil Fertility Research",
      "Karnataka State Department of Agriculture — Soil Health Card Data",
      "Krishi Vigyan Kendra publications (various districts)"
    ],
    "last_updated": "2026-09-05"
  },
