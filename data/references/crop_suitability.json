      "National Research Centre on Pomegranate (NRCP)",
      "Sugarcane Breeding Institute, Coimbatore",
      "Coconut Development Board (CDB)"
    ],
    "units": {
      "temperature": "°C (growing season average)",
      "rainfall": "mm (annual/seasonal normal)",
